  PRINT(" de n bits en complemento a 2.");
  PRINT("");
  PRINT("Presione [OK]...");
  WAIT;
  PRINT();

    PRINT("====== AYUDA (7/7) ======");
PRINT("CASOCOMP(dir,tg,off): ");
PRINT(" Analiza cache completamente asociativa");
  PRINT("");
  PRINT("Fin de ayuda.");
END;


